# Copy to .env and adjust. Never commit .env.
# Placeholder values only — safe for local development.

# PostgreSQL (used by both the postgres container and the app)
POSTGRES_USER=notify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notify
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Log every SQL statement (true/false)
DB_ECHO=false

# Redis (API key cache and the notification job queue)
REDIS_URL=redis://redis:6379/0

# Bearer token for /admin endpoints (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Seconds a valid API key lookup stays cached in Redis
API_KEY_CACHE_TTL_SECONDS=60

# --- Email worker only (the API doesn't read these) ---

# SMTP server. Mailpit locally: catches everything, web UI at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notifications@example.com

# Fake a real email provider: random delay up to this many ms per send...
SMTP_DELAY_MS=50
# ...and this share of sends fail on purpose so retries get exercised (0.0-1.0)
SMTP_FAIL_RATE=0.02

# Jobs processed at once per worker
WORKER_CONCURRENCY=20
# Attempts before a notification is marked failed and dead-lettered
WORKER_MAX_ATTEMPTS=5
# Retry n waits BASE * 2^(n-1) seconds (+/-20% jitter), capped at MAX
WORKER_RETRY_BASE_SECONDS=1
WORKER_RETRY_MAX_SECONDS=300
# On shutdown (SIGTERM), max seconds to wait for in-flight jobs
WORKER_SHUTDOWN_TIMEOUT_SECONDS=25
